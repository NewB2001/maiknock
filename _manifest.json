{
  "manifest_version": 2,
  "id": "maiknock.webui_companion",
  "version": "0.2.2",
  "name": "麦麦敲门 MaiKnock",
  "description": "WebUI 私聊伴侣插件。让麦麦主动来找你聊天，让你一键打招呼，还能由你掌管她的“现在是哪一天”——把某段时间从她的记忆里藏起来，或直接推进剧情。",
  "plugin_type": "chat",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "image"
    }
  },
  "author": {
    "name": "国强 & 烧B",
    "url": "https://github.com/NewB2001/maiknock"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NewB2001/maiknock",
    "issues": "https://github.com/NewB2001/maiknock/issues"
  },
  "host_application": {
    "min_version": "1.3.11",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.proactive.trigger",
    "maisaka.context.append",
    "message.get_recent",
    "send.text",
    "chat.get_private_streams",
    "config.get_plugin"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
