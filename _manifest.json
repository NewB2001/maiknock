{
  "manifest_version": 2,
  "id": "maiknock.webui_companion",
  "version": "0.4.0",
  "name": "麦麦敲门 MaiKnock",
  "description": "WebUI私聊体验增强！1、让麦麦主动来找你聊天；2、用旁白的方式掌控聊天剧情的时间线（就像时光机一样）；3、让麦麦用小说体的方式说话（比人格配置更稳定）；",
  "plugin_type": "chat",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "image"
    }
  },
  "author": {
    "name": "国强 & 烧B",
    "url": "https://github.com/NewB2001/maiknock"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NewB2001/maiknock",
    "issues": "https://github.com/NewB2001/maiknock/issues"
  },
  "host_application": {
    "min_version": "1.3.11",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.proactive.trigger",
    "maisaka.context.append",
    "message.get_recent",
    "send.text",
    "chat.get_private_streams",
    "config.get_plugin"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
