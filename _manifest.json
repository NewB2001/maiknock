{
  "manifest_version": 2,
  "id": "maiknock.webui_companion",
  "version": "0.2.1",
  "name": "麦麦敲门 MaiKnock",
  "description": "MaiBot WebUI 原生私聊伴侣插件：让麦麦主动来找你聊天、手动一键打招呼、虚构时间线由你掌管（/mk time add 3d 推进剧情）。",
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "image"
    }
  },
  "author": {
    "name": "国强 & 烧B",
    "url": "https://github.com/NewB2001/maiknock"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NewB2001/maiknock",
    "issues": "https://github.com/NewB2001/maiknock/issues"
  },
  "host_application": {
    "min_version": "1.3.11",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.proactive.trigger",
    "maisaka.context.append",
    "message.get_recent",
    "send.text",
    "chat.get_private_streams",
    "config.get_plugin"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
